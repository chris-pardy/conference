{
  "lexicon": 1,
  "id": "app.eventside.conference.sidecar",
  "defs": {
    "main": {
      "type": "record",
      "description": "Eventside's settings for a public conference, next to its community.lexicon.calendar.event (same rkey) in the organization's public repo.",
      "key": "any",
      "record": {
        "type": "object",
        "required": ["event", "space", "methods", "createdAt"],
        "properties": {
          "event": { "type": "string", "format": "at-uri" },
          "space": { "type": "string", "description": "The conference's space URI." },
          "methods": {
            "type": "array",
            "items": { "type": "string", "knownValues": ["code", "list", "open"] }
          },
          "theme": { "type": "unknown", "description": "Theme tokens by name, without the `--g-` prefix." },
          "template": { "type": "string" },
          "createdAt": { "type": "string", "format": "datetime" }
        }
      }
    }
  }
}
