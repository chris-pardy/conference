{
  "name": "conference",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.13.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test:rust": "cargo test --workspace",
    "test:unit": "vitest run --project unit",
    "test:integration": "cargo build -p conference-server && vitest run --project integration",
    "test:tooling": "vitest run --project tooling",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.3",
    "@vitejs/plugin-react": "6.1.1",
    "@vivarium-dev/cli": "0.0.1",
    "@vivarium-dev/client": "0.0.1",
    "jsdom": "30.1.1",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitest": "5.0.3",
    "yaml": "2.9.1"
  }
}
